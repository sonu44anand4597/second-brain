PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/brainly
# Set a cryptographically random secret of 32+ characters before production.
# Leaving this blank locally retains the original tutorial signing secret.
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Optional administrator-managed default. Users can bring their own key in AI Settings.
# Native Gemini: set AI_PROVIDER=gemini. Other named providers use their fixed endpoints.
# Leave AI_PROVIDER blank to retain the existing AI_BASE_URL compatibility behavior.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Set the exact chat model ID available in your provider account.
AI_MODEL=
# Optional embedding model ID. Blank means explicitly labelled keyword retrieval.
EMBEDDING_MODEL=

# Optional custom BYOK endpoint allowlist: exact public DNS hostnames, no schemes or paths.
AI_CUSTOM_ALLOWED_HOSTS=
# Optional local Ollama, disabled by default. The endpoint must be loopback on the API server.
AI_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
